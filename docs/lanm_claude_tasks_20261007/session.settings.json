{
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "2"
  },
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Write",
      "Edit",
      "Agent",
      "Bash"
    ],
    "deny": [
      "Bash(ssh *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git clean *)"
    ]
  }
}

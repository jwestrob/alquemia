&GLOBAL
  PROJECT WATER_PBE_ALMO
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_BENCHMARK
    POTENTIAL_FILE_NAME POTENTIAL_BENCHMARK
    CHARGE 0
    MULTIPLICITY 1
    UKS F
    &MGRID
      CUTOFF [Ry] 600
      REL_CUTOFF [Ry] 80
      NGRIDS 5
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MT
    &END POISSON
    &QS
      METHOD GAPW
      ALMO_SCF T
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-10
      EPSFIT 1.0E-6
      EPSSVD 1.0E-10
      EPSISO 1.0E-14
      EPSRHO0 1.0E-10
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-10
      MAX_SCF 300
      IGNORE_CONVERGENCE_FAILURE F
      &OT
        MINIMIZER CG
        PRECONDITIONER FULL_ALL
      &END OT
    &END SCF
    &ALMO_SCF
      ALMO_SCF_GUESS MOLECULAR
      ALMO_EXTRAPOLATION_ORDER 0
      XALMO_EXTRAPOLATION_ORDER 0
      ALMO_ALGORITHM DIAG
      XALMO_ALGORITHM PCG
      DELOCALIZE_METHOD FULL_SCF
      MO_OVERLAP_INV_ALG DENSE_CHOLESKY
      EPS_FILTER 1.0E-12
      CONSTRUCT_NLMOS F
      &ALMO_OPTIMIZER_DIIS
        EPS_ERROR 1.0E-8
        MAX_ITER 300
        N_DIIS 8
        EPS_ERROR_EARLY -1
        MAX_ITER_EARLY -1
      &END ALMO_OPTIMIZER_DIIS
      &XALMO_OPTIMIZER_PCG
        EPS_ERROR 1.0E-8
        MAX_ITER 300
        MAX_ITER_OUTER_LOOP 0
        CONJUGATOR HAGER_ZHANG
        PRECONDITIONER FULL
        LIN_SEARCH_EPS_ERROR 1.0E-3
        LIN_SEARCH_STEP_SIZE_GUESS 0.1
        EPS_ERROR_EARLY -1
        MAX_ITER_EARLY -1
      &END XALMO_OPTIMIZER_PCG
      &ANALYSIS F
      &END ANALYSIS
      &FRAGMENT 1
        CHARGE 0
        MULTIPLICITY 1
      &END FRAGMENT
      &FRAGMENT 2
        CHARGE 0
        MULTIPLICITY 1
      &END FRAGMENT
    &END ALMO_SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC [angstrom] 16.0 16.0 16.0
      PERIODIC NONE
    &END CELL
    &TOPOLOGY
      CONNECTIVITY USER
      &CENTER_COORDINATES F
      &END CENTER_COORDINATES
    &END TOPOLOGY
    &COORD
      O 1.5285821781 1.7062403635 3.9140529453 WATER1 1
      H 1.6296675630 1.2721242389 4.7873221686 WATER1 1
      H 2.0421991683 2.5306450214 4.0774366182 WATER1 1
      O 1.6497475797 0.9866814243 1.1082336734 WATER2 2
      H 1.5853337875 1.1818653541 2.0640644445 WATER2 2
      H 0.6898667621 0.8787694446 0.8082114051 WATER2 2
    &END COORD
    &KIND O
      ELEMENT O
      BASIS_SET 6-31G*
      POTENTIAL ALL
      RADIAL_GRID 200
      LEBEDEV_GRID 590
    &END KIND
    &KIND H
      ELEMENT H
      BASIS_SET 6-31G*
      POTENTIAL ALL
      RADIAL_GRID 200
      LEBEDEV_GRID 590
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

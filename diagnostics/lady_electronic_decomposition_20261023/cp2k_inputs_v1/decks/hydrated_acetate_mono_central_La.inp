&GLOBAL
  PROJECT LADY_ALMO
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME /assets/BASIS_LADY
    POTENTIAL_FILE_NAME /assets/POTENTIAL_LADY
    CHARGE 2
    MULTIPLICITY 1
    UKS F
    &MGRID
      CUTOFF [Ry] 1200
      REL_CUTOFF [Ry] 100
      NGRIDS 5
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MT
    &END POISSON
    &QS
      METHOD GAPW
      ALMO_SCF T
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-10
      EPSFIT 1.0E-6
      EPSSVD 1.0E-10
      EPSISO 1.0E-14
      EPSRHO0 1.0E-10
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-10
      MAX_SCF 300
      IGNORE_CONVERGENCE_FAILURE F
      &OT
        MINIMIZER CG
        PRECONDITIONER FULL_ALL
      &END OT
    &END SCF
    &ALMO_SCF
      ALMO_SCF_GUESS MOLECULAR
      ALMO_EXTRAPOLATION_ORDER 0
      XALMO_EXTRAPOLATION_ORDER 0
      ALMO_ALGORITHM DIAG
      XALMO_ALGORITHM PCG
      DELOCALIZE_METHOD FULL_SCF
      MO_OVERLAP_INV_ALG DENSE_CHOLESKY
      EPS_FILTER 1.0E-12
      CONSTRUCT_NLMOS F
      &ALMO_OPTIMIZER_DIIS
        EPS_ERROR 1.0E-9
        MAX_ITER 300
        N_DIIS 8
        EPS_ERROR_EARLY -1
        MAX_ITER_EARLY -1
      &END ALMO_OPTIMIZER_DIIS
      &XALMO_OPTIMIZER_PCG
        EPS_ERROR 1.0E-9
        MAX_ITER 300
        MAX_ITER_OUTER_LOOP 0
        CONJUGATOR HAGER_ZHANG
        PRECONDITIONER FULL
        LIN_SEARCH_EPS_ERROR 1.0E-3
        LIN_SEARCH_STEP_SIZE_GUESS 0.1
        EPS_ERROR_EARLY -1
        MAX_ITER_EARLY -1
      &END XALMO_OPTIMIZER_PCG
      &ANALYSIS F
      &END ANALYSIS
      &FRAGMENT 1
        CHARGE 3
        MULTIPLICITY 1
      &END FRAGMENT
      &FRAGMENT 2
        CHARGE -1
        MULTIPLICITY 1
      &END FRAGMENT
    &END ALMO_SCF
    &XC
      &XC_FUNCTIONAL NO_SHORTCUT
        &PBE
          SCALE_X 0.75
          SCALE_C 1.0
        &END PBE
      &END XC_FUNCTIONAL
      &HF
        FRACTION 0.25
        &INTERACTION_POTENTIAL
          POTENTIAL_TYPE COULOMB
        &END INTERACTION_POTENTIAL
        &SCREENING
          EPS_SCHWARZ 1.0E-12
          SCREEN_ON_INITIAL_P F
        &END SCREENING
        &MEMORY
          MAX_MEMORY 512
        &END MEMORY
      &END HF
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC [angstrom] 30.0 30.0 30.0
      PERIODIC NONE
    &END CELL
    &TOPOLOGY
      CONNECTIVITY USER
      &CENTER_COORDINATES F
      &END CENTER_COORDINATES
    &END TOPOLOGY
    &COORD
      La 0.000000000000 0.000000000000 0.000000000000 METAL 1
      C 3.869056109686 1.282384153365 2.372989359512 SHELL 2
      C 2.619561027817 0.430456025451 2.334304669344 SHELL 2
      O 2.165063509461 0.000000000000 1.250000000000 SHELL 2
      O 1.966157839400 0.330720188676 3.408678922679 SHELL 2
      H 4.633487669002 0.863088547272 1.718821032447 SHELL 2
      H 4.240288558028 1.335306236265 3.415186424581 SHELL 2
      H 3.581584492816 2.312998574352 2.067828771053 SHELL 2
      O 0.000000000000 2.165063509461 1.250000000000 SHELL 2
      H 0.756950327264 2.672452444640 1.542941138309 SHELL 2
      H -0.756950327264 2.672452444640 1.542941138309 SHELL 2
      O -2.165063509461 0.000000000000 1.250000000000 SHELL 2
      H -2.672452444640 0.756950327264 1.542941138309 SHELL 2
      H -2.672452444640 -0.756950327264 1.542941138309 SHELL 2
      O -0.000000000000 -2.165063509461 1.250000000000 SHELL 2
      H -0.756950327264 -2.672452444640 1.542941138309 SHELL 2
      H 0.756950327264 -2.672452444640 1.542941138309 SHELL 2
      O 1.530931089239 1.530931089239 -1.250000000000 SHELL 2
      H 2.424953955433 1.354464536574 -1.542941138309 SHELL 2
      H 1.354464536574 2.424953955433 -1.542941138309 SHELL 2
      O -1.530931089239 1.530931089239 -1.250000000000 SHELL 2
      H -1.354464536574 2.424953955433 -1.542941138309 SHELL 2
      H -2.424953955433 1.354464536574 -1.542941138309 SHELL 2
      O -1.530931089239 -1.530931089239 -1.250000000000 SHELL 2
      H -2.424953955433 -1.354464536574 -1.542941138309 SHELL 2
      H -1.354464536574 -2.424953955433 -1.542941138309 SHELL 2
      O 1.530931089239 -1.530931089239 -1.250000000000 SHELL 2
      H 1.354464536574 -2.424953955433 -1.542941138309 SHELL 2
      H 2.424953955433 -1.354464536574 -1.542941138309 SHELL 2
    &END COORD
    &KIND La
      ELEMENT La
      BASIS_SET LADY-ARCHIVED
      POTENTIAL ECP-LADY-La46
      RADIAL_GRID 200
      LEBEDEV_GRID 590
      ECP_SEMI_LOCAL TRUE
    &END KIND
    &KIND C
      ELEMENT C
      BASIS_SET LADY-ARCHIVED
      POTENTIAL ALL
      RADIAL_GRID 200
      LEBEDEV_GRID 590
    &END KIND
    &KIND O
      ELEMENT O
      BASIS_SET LADY-ARCHIVED
      POTENTIAL ALL
      RADIAL_GRID 200
      LEBEDEV_GRID 590
    &END KIND
    &KIND H
      ELEMENT H
      BASIS_SET LADY-ARCHIVED
      POTENTIAL ALL
      RADIAL_GRID 200
      LEBEDEV_GRID 590
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

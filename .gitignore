# Per-candidate ORCA workspaces — too large for git, regenerated by the pipeline.
# All new *_qm workspaces MUST be created under workspaces/ (not top-level).
# See DIRECTORY_POLICY.md for the layout policy.
workspaces/
*_qm/

# Legacy pre-pivot compute trees + completed validation panels — moved to
# legacy/ during the 2026-07-16 directory cleanup. Individual entries kept
# below as a safety net in case any old scripts try to recreate them at
# top level.
legacy/
qmmm/
qmmm_lc/
qmmm_md/
b97_3c_panel/
calexcitin_size_panel/
spicy_lams_low_cn_staging/

# Per-batch logs
logs/

# Inbox staging (symlinks + processed CIFs; outputs only, not source)
inbox/processed/
inbox/apo_skipped/
inbox/stale_pre_cn_filter/
inbox/_filter_passed.txt
inbox/_filter_rejected.txt
inbox/_session_*.tsv
inbox/*.cif

# SLURM artifacts (regenerated by submit scripts; cluttering)
slurm-*.out
slurm-*.err
*.slurm

# ORCA scratch and per-job artifacts (regenerated; large)
*.gbw
*.tmp
*.bas*
*.densities
*.cis
*.qro
*.uno
*.scfp
*.scfr
*.engrad
*.opt
*.trj
*.densitiesinfo

# Python caches
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# OS noise
.DS_Store
Thumbs.db

# Editor noise
*.swp
*.swo
*~
.idea/
.vscode/

# Working notes / internal coordination (not for public release)
docs_buildout_brief.md

# Pre-discriminator-pivot REPORT and HANDOFF — keep historical but flag for review;
# uncomment to exclude if pre-pivot context is undesirable in the public repo:
# REPORT.md
# HANDOFF.md

# Local lock files (system tempfiles)
/tmp/process_inbox.lock
/tmp/inbox_watcher.lock

# Recarve watcher runtime log (regenerated by scripts/recarve_watcher.sh)
results/recarve_watcher.log

+def parse_allocation(raw, environ, hostname, uid):
+    from decimal import Decimal
+    job=environ.get('SLURM_JOB_ID','')
+    assert job.isdecimal() and job!='0','actual Slurm job ID required'
+    fields=dict(word.split('=',1) for word in raw.split() if '=' in word)
+    expected={'JobId':job,'JobState':'RUNNING','Account':'banfield','QOS':'standard_expand','Partition':'standard',
+              'NumNodes':'1','NumCPUs':'12','NumTasks':'1','CPUs/Task':'12','Requeue':'0','OverSubscribe':'NO'}
+    for key,value in expected.items():assert fields.get(key)==value,'allocation '+key
+    assert fields['BatchHost'].split('.')[0]==hostname.split('.')[0],'allocated compute host'
+    assert fields['UserId'].endswith('('+str(uid)+')'),'allocated user'
+    assert environ.get('SLURM_CPUS_PER_TASK')=='12' and environ.get('SLURM_NTASKS')=='1'
+    assert environ.get('SLURM_JOB_NUM_NODES',environ.get('SLURM_NNODES'))=='1'
+    tres=dict(x.split('=',1) for x in fields['AllocTRES'].split(','))
+    assert tres['cpu']=='12' and tres['node']=='1'
+    units={'K':1024,'M':1024**2,'G':1024**3,'T':1024**4}
+    def memory(text):
+        assert text[-1] in units
+        value=Decimal(text[:-1])*units[text[-1]]
+        assert value==int(value);return int(value)
+    grant=memory(tres['mem'])
+    assert grant==48000*1024**2 and grant>=32*1024**3,'default48000MiB grant and32GiB cap'
+    assert memory(fields['MinMemoryCPU'])==4000*1024**2,'default memory per CPU'
+    return dict(mode='slurm',job_id=job,hostname=hostname,account=fields['Account'],partition=fields['Partition'],qos=fields['QOS'],
+                nodes=1,tasks=1,allocated_CPUs=12,memory_grant_bytes=grant,default_memory_MiB_per_CPU=4000,
+                requeue=False,exclusive=False,raw_scontrol=raw,scheduler_allocated_CPU_seconds=None)
+
+
+def allocation(cfg):
+    job=os.environ.get('SLURM_JOB_ID','');assert job.isdecimal() and job!='0'
+    cmd=[cfg['scheduler_command'],'show','job',job,'-o']
+    completed=subprocess.run(cmd,capture_output=True,text=True,timeout=15,check=True)
+    assert not completed.stderr.strip(),'scheduler readback stderr'
+    result=parse_allocation(completed.stdout,os.environ,socket.gethostname(),os.getuid())
+    result['argv']=cmd
+    result['affinity_CPUs']=len(os.sched_getaffinity(0))
+    assert result['affinity_CPUs']>=12,'allocated CPU affinity'
+    return result
 
 
